{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QuestionBankPackageV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bankId", "bankVersion", "name", "exportedAt", "publisher", "questions", "materials", "knowledgePoints", "media"],
  "properties": {
    "schemaVersion": { "const": "1.0" }, "bankId": { "$ref": "#/$defs/nonEmptyString" }, "bankVersion": { "type": "string", "minLength": 1 }, "name": { "$ref": "#/$defs/nonEmptyString" }, "description": { "type": ["string", "null"] }, "exportedAt": { "type": "string", "format": "date-time" }, "publisher": { "$ref": "#/$defs/nonEmptyString" },
    "questions": { "type": "array", "items": { "$ref": "#/$defs/Question" } }, "materials": { "type": "array", "items": { "$ref": "#/$defs/Material" } }, "knowledgePoints": { "type": "array", "items": { "$ref": "#/$defs/KnowledgePoint" } }, "media": { "type": "array", "items": { "$ref": "#/$defs/MediaRef" } }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 }, "externalId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }, "idRefs": { "type": "array", "items": { "$ref": "#/$defs/externalId" }, "uniqueItems": true },
    "Question": { "type": "object", "additionalProperties": false, "required": ["externalId", "questionType", "content", "classification", "provenance", "answerStatus", "flags"], "properties": { "externalId": { "$ref": "#/$defs/externalId" }, "questionType": { "type": "string", "enum": ["SINGLE_CHOICE"] }, "content": { "$ref": "#/$defs/QuestionContent" }, "classification": { "$ref": "#/$defs/Classification" }, "materialExternalId": { "anyOf": [{ "$ref": "#/$defs/externalId" }, { "type": "null" }] }, "paperContext": { "anyOf": [{ "$ref": "#/$defs/PaperContext" }, { "type": "null" }] }, "provenance": { "$ref": "#/$defs/Provenance" }, "answerStatus": { "type": "string", "enum": ["VERIFIED", "UNVERIFIED", "DISPUTED"] }, "flags": { "$ref": "#/$defs/Flags" } } },
    "QuestionContent": { "type": "object", "additionalProperties": false, "required": ["stem", "media", "options", "correctAnswer", "explanation"], "properties": { "stem": { "$ref": "#/$defs/nonEmptyString" }, "media": { "$ref": "#/$defs/idRefs" }, "options": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/QuestionOption" } }, "correctAnswer": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" }, "uniqueItems": true }, "explanation": { "type": ["string", "null"] } } },
    "QuestionOption": { "type": "object", "additionalProperties": false, "required": ["key", "text", "media"], "properties": { "key": { "$ref": "#/$defs/nonEmptyString" }, "text": { "type": ["string", "null"] }, "media": { "$ref": "#/$defs/idRefs" } } },
    "Classification": { "type": "object", "additionalProperties": false, "required": ["module", "subtype", "knowledgePointExternalIds", "sourceTags"], "properties": { "module": { "type": ["string", "null"] }, "subtype": { "type": ["string", "null"] }, "knowledgePointExternalIds": { "$ref": "#/$defs/idRefs" }, "sourceTags": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" }, "uniqueItems": true }, "sourceDifficulty": { "anyOf": [{ "$ref": "#/$defs/SourceDifficulty" }, { "type": "null" }] }, "referenceTimeSeconds": { "type": ["integer", "null"], "exclusiveMinimum": 0 } } },
    "SourceDifficulty": { "type": "object", "additionalProperties": false, "required": ["value", "scale", "provider"], "properties": { "value": { "$ref": "#/$defs/nonEmptyString" }, "scale": { "$ref": "#/$defs/nonEmptyString" }, "provider": { "$ref": "#/$defs/nonEmptyString" } } },
    "Material": { "type": "object", "additionalProperties": false, "required": ["externalId", "title", "content", "media", "provenance"], "properties": { "externalId": { "$ref": "#/$defs/externalId" }, "title": { "type": ["string", "null"] }, "content": { "type": ["string", "null"] }, "media": { "$ref": "#/$defs/idRefs" }, "provenance": { "$ref": "#/$defs/Provenance" } } },
    "KnowledgePoint": { "type": "object", "additionalProperties": false, "required": ["externalId", "name", "parentExternalId", "level", "type"], "properties": { "externalId": { "$ref": "#/$defs/externalId" }, "name": { "$ref": "#/$defs/nonEmptyString" }, "parentExternalId": { "anyOf": [{ "$ref": "#/$defs/externalId" }, { "type": "null" }] }, "level": { "type": "integer", "minimum": 1 }, "type": { "$ref": "#/$defs/nonEmptyString" } } },
    "MediaRef": { "type": "object", "additionalProperties": false, "required": ["externalId", "type", "role", "path", "url"], "properties": { "externalId": { "$ref": "#/$defs/externalId" }, "type": { "type": "string", "enum": ["IMAGE", "TABLE", "CHART"] }, "role": { "type": "string", "enum": ["STEM", "OPTION", "MATERIAL", "ANALYSIS"] }, "path": { "type": ["string", "null"], "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+" }, "url": { "type": ["string", "null"], "format": "uri" } } },
    "Provenance": { "type": "object", "additionalProperties": false, "required": ["content", "answer", "analysis"], "properties": { "content": { "$ref": "#/$defs/SourceRef" }, "answer": { "anyOf": [{ "$ref": "#/$defs/SourceRef" }, { "type": "null" }] }, "analysis": { "anyOf": [{ "$ref": "#/$defs/SourceRef" }, { "type": "null" }] } } },
    "SourceRef": { "type": "object", "additionalProperties": false, "required": ["provider", "sourceType", "sourceName", "sourceUrl", "originalId", "sourceRecordId", "sourceFile", "sourcePage", "credibility", "license", "copyrightNote"], "properties": { "provider": { "$ref": "#/$defs/nonEmptyString" }, "sourceType": { "type": "string", "enum": ["REAL_EXAM", "INSTITUTION", "MANUAL", "AI_GENERATED"] }, "sourceName": { "$ref": "#/$defs/nonEmptyString" }, "sourceUrl": { "type": ["string", "null"], "format": "uri" }, "originalId": { "type": ["string", "null"] }, "sourceRecordId": { "type": ["string", "null"] }, "sourceFile": { "type": ["string", "null"] }, "sourcePage": { "type": ["integer", "null"], "exclusiveMinimum": 0 }, "credibility": { "type": "string", "enum": ["S", "A", "B", "C", "D"] }, "license": { "type": ["string", "null"] }, "copyrightNote": { "type": ["string", "null"] } } },
    "PaperContext": { "type": "object", "additionalProperties": false, "properties": { "exam": { "type": ["string", "null"] }, "year": { "type": ["integer", "null"] }, "province": { "type": ["string", "null"] }, "paperType": { "type": ["string", "null"] }, "paperName": { "type": ["string", "null"] }, "originalQuestionNumber": { "type": ["string", "null"] }, "section": { "type": ["string", "null"] } } },
    "Flags": { "type": "object", "additionalProperties": false, "required": ["isActive"], "properties": { "isActive": { "type": "boolean" } } }
  }
}
